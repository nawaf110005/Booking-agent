# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=sqlite:///./booking.db
LOG_LEVEL=INFO

# --- LLM provider that drives the agent (F002) ---
# Options: anthropic | openai | nanogpt
# The agent works WITHOUT a key (rule-based fallback); a key enables full NLU.
BOOKING_AGENT_PROVIDER=anthropic
BOOKING_AGENT_MODEL=claude-sonnet-4-6

# Provider keys (set the one matching the provider above).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Nano-GPT is an OpenAI-compatible proxy (cheap, many models). Get a key at
# https://nano-gpt.com — then set BOOKING_AGENT_PROVIDER=nanogpt and a model
# like gpt-4o-mini.
NANOGPT_API_KEY=

# --- Booking rules ---
HOLD_TTL_MINUTES=10
VAT_RATE=0.15
CURRENCY=SAR

# --- Payments: Moyasar sandbox (F003) ---
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
PAYMENT_GATEWAY=fake          # fake | moyasar  (fake = offline demo, no network)

# --- Ticket signing (F003): HMAC key for the QR token. CHANGE in production. ---
TICKET_HMAC_KEY=dev-insecure-change-me

# --- Email delivery (F003) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=tickets@booking-agent.local

# --- Admin-token-gated endpoints (/v1/admin/*) — unset = disabled ---
BOOKING_AGENT_ADMIN_TOKEN=

# --- CORS allowlist (comma-separated). Defaults to the Streamlit dev origin. ---
# BOOKING_AGENT_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Windows: set to 1 to avoid console UnicodeEncodeError with rich tables.
# PYTHONUTF8=1
